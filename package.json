{
  "name": "pawn-playground-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild web/js/ppg-editor.js --bundle --format=iife --target=es2020 --minify --legal-comments=eof --outfile=web/js/ppg-editor.bundle.js",
    "watch": "npm run build -- --watch",
    "test": "node --test web/editor-tests/*.test.js",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@replit/codemirror-vscode-keymap": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
